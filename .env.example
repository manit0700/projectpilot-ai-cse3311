# Optional live manager planning. Keep real keys in .env.local, never in git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Choose Demo or Live API in the app before starting a project.
# Live specialists and review use the same server configuration.
# Required in production: a strong access code shared privately with reviewers.
LIVE_ACCESS_CODE=

# Website Studio: free-only OpenRouter models. Never put keys in the browser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional per-role overrides; each must be openrouter/free or end in :free.
# OPENROUTER_MANAGER_MODEL=
# OPENROUTER_DEVELOPER_MODEL=
# OPENROUTER_REVIEWER_MODEL=

# GitHub MCP: server-side token restricted to this repository.
GITHUB_MCP_TOKEN=
GITHUB_MCP_REPOSITORY=manit0700/projectpilot-ai-cse3311
GITHUB_MCP_BASE_BRANCH=master

# Optional: AI_PROVIDER=openrouter routes the original manager and specialists too.
# When omitted, OPENROUTER_API_KEY takes precedence if configured.
AI_PROVIDER=openrouter

# Optional for a fixed model supporting non-reasoning mode only.
# Leave unset for automatic routing or mandatory-reasoning models.
# OPENROUTER_REASONING=off
