# ProjectPilot AI — server-side configuration.
# Copy to .env.local (ignored by git). Never commit real keys or paste them into chat.
# Demo mode needs none of these. Live API and Website Studio need one provider key.

# ---------------------------------------------------------------------------
# AI provider selection
# ---------------------------------------------------------------------------
# Three providers are supported for the planning workflow (manager, answers, specialists, review):
#   gemini     — Google Gemini API free tier. Free key (no card): https://aistudio.google.com/apikey
#                Best free quality, but each model has a per-day cap (observed: 429 on every listed model
#                after about 60 requests in one day). A full Live project costs about 14 requests.
#   openrouter — free-only OpenRouter models (50 requests/day until a one-time $10 credit
#                raises it to 1,000); Website Studio uses it unless AI_PROVIDER=gemini.
#   openai     — OpenAI Responses API with strict JSON-schema output (paid, owner pays).
# Resolution order when AI_PROVIDER is unset: OpenRouter if OPENROUTER_API_KEY is set, then Gemini if
# GEMINI_API_KEY is set, otherwise OpenAI. To use Gemini while an OpenRouter key is also set, set
# AI_PROVIDER=gemini. An active AI_PROVIDER whose key is missing makes every live request fail with a 503.
# AI_PROVIDER=gemini
# AI_PROVIDER=openrouter
# AI_PROVIDER=openai
#
# Website Studio follows Gemini when AI_PROVIDER=gemini; otherwise it uses free-only OpenRouter,
# even if AI_PROVIDER=openai (Studio has no OpenAI path).

# Fallback providers (src/lib/provider-chain.ts; used by the manager, specialist and studio routes).
# Comma-separated list, in order, tried only AFTER the primary provider (and its model list) fails with a
# quota or capacity problem (429, 5xx, 404, timeout, network). A rejected key or invalid request stops the
# chain, because another provider cannot fix it. Only listed providers that have a key are used, and the
# primary is never repeated. Nothing is added implicitly: OpenAI is a fallback only if you list it, because
# it is the only paid option. Website Studio can fall back only between gemini and openrouter.
# Example: AI_PROVIDER=gemini plus AI_FALLBACK=openrouter
# AI_FALLBACK=

# Rate limit on /api/manager and /api/specialist (src/lib/rate-limit.ts, applied in both routes). Maximum requests per 10 minutes per client IP; default 60 when unset,
# empty or not a positive number; read once when the server starts. The limiter is in memory per server
# instance, so it is defence in depth only; the real control in production is a Vercel Firewall rate-limit rule.
# PLANNER_RATE_LIMIT=60

# Google Gemini (planning workflow). Free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
# A comma-separated list is tried in order when a model is busy, retired or out of quota (free quota is per model).
# Optional per-role overrides: GEMINI_MANAGER_MODEL, GEMINI_DEVELOPER_MODEL, GEMINI_REVIEWER_MODEL.
# Thinking effort (default low; thinking tokens share the output budget). Use off to omit the setting.
# GEMINI_REASONING_EFFORT=low

# OpenAI (planning workflow only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenRouter (planning workflow when selected; Website Studio uses it unless AI_PROVIDER=gemini)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional per-role overrides; each must be openrouter/free or end in :free.
# Requests additionally cap prompt/completion prices at zero; there is no paid fallback.
# OPENROUTER_MANAGER_MODEL=
# OPENROUTER_DEVELOPER_MODEL=
# OPENROUTER_REVIEWER_MODEL=
# Only for a fixed model that supports non-reasoning mode. Leave unset for automatic
# routing or for models that require reasoning.
# OPENROUTER_REASONING=off

# ---------------------------------------------------------------------------
# Live API access control
# ---------------------------------------------------------------------------
# Required in production. Visitors must enter this code and accept the data-sharing
# notice before any live request; Demo mode stays public. Use at least 20 characters
# (a random passphrase, not a word) and share it privately with reviewers only.
# Local development may leave it empty, which hides the code field.
# The application-level check is a shared secret, not per-user auth. Brute-force
# protection for the deployed app is a Vercel WAF rate-limit rule on /api/live-access
# (and the other /api routes); configure it in the Vercel project's Firewall settings.
LIVE_ACCESS_CODE=

# ---------------------------------------------------------------------------
# GitHub MCP publishing — EXPERIMENTAL, NOT ENABLED IN PRODUCTION
# ---------------------------------------------------------------------------
# Lets Website Studio import projectpilot-site/index.html from a repository and open a
# draft pull request on a projectpilot/site-* branch. Leave all three empty to disable
# the GitHub panel. Production deployments currently do not set these.
# Token: create a fine-grained GitHub personal access token limited to ONE repository
# (the one named below) with only Contents: Read and write and Pull requests: Read and
# write. Do not use a classic token or a token with access to all repositories.
GITHUB_MCP_TOKEN=
GITHUB_MCP_REPOSITORY=manit0700/projectpilot-ai-cse3311
# Base branch for imports and pull requests. The code defaults to "main" when this is
# unset; this repository's default branch is "master", so set it explicitly.
GITHUB_MCP_BASE_BRANCH=master
